    "scenes":  {
                   "opening":  {
                                   "line_1":  {
                                                  "text":  "1958. NASA is six months old. Everyone wants the Moon."
                                              },
                                   "line_2":  {
                                                  "text":  "Walter Rhodes wanted it more than anyone. He designed Project SELENE: America\u0027s first crewed lunar landing."
                                              },
                                   "line_3":  {
                                                  "text":  "He worked nights. Weekends. Birthdays."
                                              },
                                   "line_4":  {
                                                  "text":  "On the night of his kid\u0027s science fair, he worked late again."
                                              },
                                   "fight_1":  {
                                                   "speaker":  "kid",
                                                   "text":  "You said you\u0027d come."
                                               },
                                   "fight_2":  {
                                                   "speaker":  "dad",
                                                   "text":  "The test ran long, kiddo. I\u0027m sorry, I—"
                                               },
                                   "fight_3":  {
                                                   "speaker":  "kid",
                                                   "text":  "You don\u0027t even care about me. All you care about is that stupid mission."
                                               },
                                   "fight_4":  {
                                                   "speaker":  "dad",
                                                   "text":  "That\u0027s not… I\u0027m sorry. I wanted to come. I really did."
                                               },
                                   "fight_5":  {
                                                   "speaker":  "kid",
                                                   "text":  "All you do is lie to me."
                                               },
                                   "line_5":  {
                                                  "text":  "Three weeks later, he was gone."
                                              },
                                   "line_6":  {
                                                  "text":  "NASA shelved SELENE the same month. Too risky. Too expensive. Too much Walter."
                                              },
                                   "line_7":  {
                                                  "text":  "Six months later, his kid walks through the front door."
                                              },
                                   "title":  {
                                                 "text":  "PROJECT DAEDALUS"
                                             }
                               },
                   "lobby":  {
                                 "mom_note":  {
                                                  "speaker":  "mom_note",
                                                  "text":  "Be home for dinner. Please. It took him; don\u0027t let it take you too. Love, Mom."
                                              },
                                 "guard_1":  {
                                                 "speaker":  "guard",
                                                 "text":  "Badge? …Rhodes. Huh. Sorry about your dad, kid."
                                             },
                                 "guard_2":  {
                                                 "speaker":  "guard",
                                                 "text":  "Director Pike\u0027s waiting upstairs. Lift\u0027s down the hall."
                                             }
                             },
                   "pike_office":  {
                                       "board_warning":  {
                                                             "speaker":  "pike",
                                                             "text":  "I bought this project a month. If the satellite misses orbit, the board will close the bay."
                                                         },
                                       "brief_1":  {
                                                       "speaker":  "pike",
                                                       "text":  "Rhodes. Your file says clerk. Today it says team lead engineer. Try to make the title stick."
                                                   },
                                       "brief_2":  {
                                                       "speaker":  "pike",
                                                       "text":  "The satellite team is three people and bad coffee. You\u0027re leading DAEDALUS-1, a camera satellite to bring back clear photographs of the Moon."
                                                   },
                                       "brief_3":  {
                                                       "speaker":  "pike",
                                                       "text":  "Get the camera into a steady orbit, point it at the Moon, and bring the photographs home. The launch is the first hard part."
                                                   },
                                       "brief_4":  {
                                                       "speaker":  "pike",
                                                       "text":  "Fifteen million dollars. That buys the rocket, the camera, and one chance. Don\u0027t spend it twice."
                                                   },
                                       "brief_5":  {
                                                       "speaker":  "pike",
                                                       "text":  "Dot is in the Design Bay. He\u0027ll help you learn the equipment. You\u0027ll make the calls."
                                                   },
                                       "photo":  {
                                                     "speaker":  "photo",
                                                     "text":  "An old photo: Pike and Walter at a launch, both grinning."
                                                 },
                                       "after_photo_1":  {
                                                             "speaker":  "pike",
                                                             "text":  "…He was the best engineer I ever worked with. And I didn\u0027t listen to him once when it mattered."
                                                         },
                                       "after_photo_2":  {
                                                             "speaker":  "pike",
                                                             "text":  "Get out of my office, Rhodes."
                                                         },
                                       "refuse_1":  {
                                                        "speaker":  "pike",
                                                        "text":  "That\u0027s not in the budget, Rhodes."
                                                    },
                                       "refuse_2":  {
                                                        "speaker":  "pike",
                                                        "text":  "Do I look like I\u0027m made of money? Don\u0027t answer that."
                                                    },
                                       "refuse_3":  {
                                                        "speaker":  "pike",
                                                        "text":  "Fifteen million. I can count. Can you?"
                                                    }
                                   },
                   "design_bay":  {
                                      "intro_1":  {
                                                      "speaker":  "dot",
                                                      "text":  "You\u0027re Walter\u0027s kid. You\u0027ve got his frown."
                                                  },
                                      "intro_2":  {
                                                      "speaker":  "dot",
                                                      "text":  "Mug number six. Don\u0027t touch it."
                                                  },
                                      "intro_3":  {
                                                      "speaker":  "dot",
                                                      "text":  "Rule one: the rocket has to fly straight. Heavy stuff up front, fins at the back, like an arrow."
                                                  },
                                      "intro_4":  {
                                                      "speaker":  "dot",
                                                      "text":  "Rule two: enough fuel to get where you\u0027re going. Rockets mostly carry fuel to carry fuel."
                                                  },
                                      "intro_5":  {
                                                      "speaker":  "dot",
                                                      "text":  "Rule three: one stage won\u0027t make orbit. Nobody\u0027s does. Stack them."
                                                  },
                                      "intro_6":  {
                                                      "speaker":  "dot",
                                                      "text":  "Build it on the bench. Then take it upstairs to the IBM. The computer doesn\u0027t lie. People do."
                                                  },
                                      "fb_stable_good":  {
                                                             "speaker":  "dot",
                                                             "text":  "Look at that. Your dad would\u0027ve signed off on it. …Eventually."
                                                         },
                                      "fb_wobbly":  {
                                                        "speaker":  "dot",
                                                        "text":  "It\u0027ll fly like a drunk pigeon. Bigger fins, or move weight up front."
                                                    },
                                      "fb_tumbles":  {
                                                         "speaker":  "dot",
                                                         "text":  "That\u0027s not a rocket, that\u0027s a pinwheel. Fins. Back. Bigger."
                                                     },
                                      "fb_over_stable":  {
                                                             "speaker":  "dot",
                                                             "text":  "Too much fin. It\u0027ll turn into the wind like a weathervane."
                                                         },
                                      "fb_not_enough_fuel":  {
                                                                 "speaker":  "dot",
                                                                 "text":  "You\u0027ll get halfway to orbit and then visit the ocean."
                                                             },
                                      "fb_too_heavy":  {
                                                           "speaker":  "dot",
                                                           "text":  "It\u0027s not leaving the pad. Lighter, or more engine."
                                                       },
                                      "fb_ready":  {
                                                       "speaker":  "dot",
                                                       "text":  "Run it through the IBM. Then we talk launch."
                                                   },
                                      "about_dad_1":  {
                                                          "speaker":  "dot",
                                                          "text":  "Walter hired me when nobody else would. Brought two coffees every morning, one for me. Every day."
                                                      },
                                      "about_dad_2":  {
                                                          "speaker":  "dot",
                                                          "text":  "He kept a model rocket on his desk. Said a kid designed the fins. Never told me which kid."
                                                      }
                                  },
                   "cafeteria":  {
                                     "jo_1":  {
                                                  "speaker":  "jo",
                                                  "text":  "You\u0027re Walt\u0027s kid, right? I\u0027m Jo. I was supposed to fly SELENE."
                                              },
                                     "jo_2":  {
                                                  "speaker":  "jo",
                                                  "text":  "Your dad stayed up three nights checking my oxygen numbers. Nobody asked him to. He just wanted the crew to come home."
                                              },
                                     "jo_3":  {
                                                  "speaker":  "jo",
                                                  "text":  "He talked about you more than the Moon. Don\u0027t let anybody tell you otherwise."
                                              },
                                     "jo_return":  {
                                                       "speaker":  "jo",
                                                       "text":  "Go build something, kid. I\u0027ll be watching from mission control."
                                                   },
                                     "coffee_pot":  {
                                                        "speaker":  "coffee_pot",
                                                        "text":  "Nearly empty. A note: \"DOT\u0027S. TOUCH AND DIE.\""
                                                    }
                                 },
                   "ibm_room":  {
                                    "operator_intro":  {
                                                           "speaker":  "operator",
                                                           "text":  "Punch your numbers, feed the deck, wait for the whir. Don\u0027t drop the cards. Ever."
                                                       },
                                    "operator_after_printout":  {
                                                                    "speaker":  "operator",
                                                                    "text":  "Machine\u0027s happy. That\u0027s one of us."
                                                                }
                                },
                   "barks":  {
                                 "slide_rule":  {
                                                    "text":  "Has anyone seen my slide rule?"
                                                },
                                 "third_coffee":  {
                                                      "text":  "Third coffee. Third."
                                                  },
                                 "card_deck":  {
                                                   "text":  "The IBM ate my card deck again."
                                               },
                                 "walters_kid":  {
                                                     "text":  "Is that Walter\u0027s kid?"
                                                 },
                                 "fins_at_back":  {
                                                      "text":  "Fins at the back. Always fins at the back."
                                                  },
                                 "booster_hallway":  {
                                                         "text":  "Who parked a booster in the hallway?"
                                                     }
                             },
                   "pa":  {
                              "fish":  {
                                           "text":  "Attention: the cafeteria fish has been… discontinued."
                                       },
                              "slide_rule":  {
                                                 "text":  "Would the owner of a blue slide rule report to the IBM room."
                                             },
                              "hazard_drill":  {
                                                   "text":  "Reminder: launch hazard drill at fifteen hundred."
                                               }
                          },
                   "mission_control":  {
                                           "poll_flight":  {
                                                               "speaker":  "flight",
                                                               "text":  "Poll the room."
                                                           },
                                           "booster_go":  {
                                                              "speaker":  "booster",
                                                              "text":  "GO."
                                                          },
                                           "booster_nogo":  {
                                                                "speaker":  "booster",
                                                                "text":  "NO-GO, thrust is marginal."
                                                            },
                                           "fido_go":  {
                                                           "speaker":  "fido",
                                                           "text":  "GO."
                                                       },
                                           "fido_nogo":  {
                                                             "speaker":  "fido",
                                                             "text":  "NO-GO, we\u0027re short on delta-v."
                                                         },
                                           "eecom_go":  {
                                                            "speaker":  "eecom",
                                                            "text":  "GO."
                                                        },
                                           "guidance_go":  {
                                                               "speaker":  "guidance",
                                                               "text":  "GO."
                                                           },
                                           "guidance_nogo":  {
                                                                 "speaker":  "guidance",
                                                                 "text":  "NO-GO, she\u0027s unstable."
                                                             },
                                           "capcom_go":  {
                                                             "speaker":  "capcom",
                                                             "text":  "Flight, we are GO for launch."
                                                         },
                                           "count_10":  {
                                                            "speaker":  "countdown",
                                                            "text":  "T-10…"
                                                        },
                                           "count_9":  {
                                                           "speaker":  "countdown",
                                                           "text":  "9…"
                                                       },
                                           "count_8":  {
                                                           "speaker":  "countdown",
                                                           "text":  "8…"
                                                       },
                                           "count_7":  {
                                                           "speaker":  "countdown",
                                                           "text":  "7…"
                                                       },
                                           "count_6":  {
                                                           "speaker":  "countdown",
                                                           "text":  "6…"
                                                       },
                                           "count_5":  {
                                                           "speaker":  "countdown",
                                                           "text":  "5…"
                                                       },
                                           "count_4":  {
                                                           "speaker":  "countdown",
                                                           "text":  "4…"
                                                       },
                                           "count_3":  {
                                                           "speaker":  "countdown",
                                                           "text":  "3…"
                                                       },
                                           "count_2":  {
                                                           "speaker":  "countdown",
                                                           "text":  "2…"
                                                       },
                                           "count_1":  {
                                                           "speaker":  "countdown",
                                                           "text":  "1…"
                                                       },
                                           "call_liftoff":  {
                                                                "speaker":  "loop",
                                                                "text":  "Ignition. … Liftoff! We have liftoff!"
                                                            },
                                           "call_tower":  {
                                                              "speaker":  "loop",
                                                              "text":  "Tower cleared."
                                                          },
                                           "call_roll":  {
                                                             "speaker":  "loop",
                                                             "text":  "Roll program."
                                                         },
                                           "call_max_q":  {
                                                              "speaker":  "loop",
                                                              "text":  "Max-Q."
                                                          },
                                           "call_staging":  {
                                                                "speaker":  "loop",
                                                                "text":  "Staging. Second stage ignition."
                                                            },
                                           "call_cutoff":  {
                                                               "speaker":  "loop",
                                                               "text":  "Engine cutoff."
                                                           },
                                           "success_fido":  {
                                                                "speaker":  "fido",
                                                                "text":  "We have an orbit!"
                                                            },
                                           "success_dot":  {
                                                               "speaker":  "dot",
                                                               "text":  "Mug number six. You can touch it. Once."
                                                           },
                                           "success_pike":  {
                                                                "speaker":  "pike",
                                                                "text":  "Under budget. …Good work, Rhodes."
                                                            },
                                           "fail_no_liftoff":  {
                                                                   "speaker":  "booster",
                                                                   "text":  "No liftoff! Shut it down!"
                                                               },
                                           "fail_fell_short":  {
                                                                   "speaker":  "fido",
                                                                   "text":  "We\u0027re not going to make orbit… she\u0027s coming back down."
                                                               },
                                           "fail_broke_up":  {
                                                                 "speaker":  "eecom",
                                                                 "text":  "We\u0027ve lost telemetry."
                                                             },
                                           "fail_tumbling":  {
                                                                 "speaker":  "guidance",
                                                                 "text":  "She\u0027s tumbling, she\u0027s tumbling!"
                                                             },
                                           "fail_dot_after":  {
                                                                  "speaker":  "dot",
                                                                  "text":  "Hey. Your dad lost one like this. He didn\u0027t sleep for a week. Then he fixed it. Try again."
                                                              }
                                       },
                   "dad_office":  {
                                      "brass_key":  {
                                                        "speaker":  "brass_key",
                                                        "text":  "A brass key. Tag says \"W.R.\" in Dot\u0027s handwriting."
                                                    },
                                      "obj_nameplate":  {
                                                            "speaker":  "nameplate",
                                                            "text":  "W. RHODES, LEAD DESIGNER, PROJECT SELENE. Someone scratched SELENE off."
                                                        },
                                      "obj_moon_poster":  {
                                                              "speaker":  "moon_poster",
                                                              "text":  "Covered in pencil notes. Landing sites circled. One is labelled \"for the kid.\""
                                                          },
                                      "obj_model_rocket":  {
                                                               "speaker":  "model_rocket",
                                                               "text":  "Hand-built. One fin snapped off. It looks a lot like the one you made for the science fair."
                                                           },
                                      "obj_photo":  {
                                                        "speaker":  "photo",
                                                        "text":  "You, age seven, in a cardboard space helmet. Dad\u0027s laughing."
                                                    },
                                      "obj_mugs":  {
                                                       "speaker":  "mugs",
                                                       "text":  "Four of them. All empty. All from the same night."
                                                   },
                                      "obj_calendar":  {
                                                           "speaker":  "calendar",
                                                           "text":  "Every day crossed out, up to one. The science fair. Circled twice. Not crossed out."
                                                       },
                                      "obj_drawer":  {
                                                         "speaker":  "drawer",
                                                         "text":  "Locked. A label reads \"SELENE: FINAL.\" You\u0027ll need a key."
                                                     },
                                      "tape1_1":  {
                                                      "speaker":  "dad_tape",
                                                      "text":  "Log one. It\u0027s 2 a.m. Coffee number four. Don\u0027t tell your mother."
                                                  },
                                      "tape1_2":  {
                                                      "speaker":  "dad_tape",
                                                      "text":  "Every rocket has a number: how much it can lift. Respect the number."
                                                  },
                                      "tape2_1":  {
                                                      "speaker":  "dad_tape",
                                                      "text":  "Log nine. Pike signed off on the cheaper heat shield. I told him it\u0027ll fail."
                                                  },
                                      "tape2_2":  {
                                                      "speaker":  "dad_tape",
                                                      "text":  "He said the budget\u0027s the budget. …I\u0027m going to fix it myself. Even if it takes every night I have."
                                                  },
                                      "tape3_1":  {
                                                      "speaker":  "dad_tape",
                                                      "text":  "Log fourteen. Missed the fair. I keep missing things."
                                                  },
                                      "tape3_2":  {
                                                      "speaker":  "dad_tape",
                                                      "text":  "Ruth says I\u0027m building a rocket to escape the house. Maybe she\u0027s right."
                                                  },
                                      "tape3_3":  {
                                                      "speaker":  "dad_tape",
                                                      "text":  "But it\u0027s not for me. One day I\u0027ll tell the kid what it\u0027s really for."
                                                  },
                                      "tape3_4":  {
                                                      "speaker":  "dad_tape",
                                                      "text":  "…I saw the photo. Your fins were better than ours. I promise I\u0027ll explain."
                                                  }
                                  },
                   "ending":  {
                                  "to_be_continued":  {
                                                          "text":  "Next, you\u0027ll be Principal Engineer, guiding the department\u0027s plan for a monkey mission around the Moon. Later, as Chief Program Technologist, you\u0027ll help prepare a human lunar mission."
                                                      },
                                  "project_name":  {
                                                       "text":  "PROJECT DAEDALUS"
                                                   },
                                  "level_complete":  {
                                                         "text":  "DAEDALUS-1 is in orbit. Promotion: Principal Engineer."
                                                     }
                              },
                   "objectives":  {
                                      "report_to_pike":  {
                                                             "text":  "Report to Director Pike"
                                                         },
                                      "visit_design_bay":  {
                                                               "text":  "Visit the Design Bay"
                                                           },
                                      "talk_to_dot":  {
                                                          "text":  "Talk to Dot"
                                                      },
                                      "build_beacon":  {
                                                           "text":  "Design the DAEDALUS-1 Moon camera satellite"
                                                       },
                                      "run_ibm":  {
                                                      "text":  "Run it through the IBM 7090"
                                                  },
                                      "launch":  {
                                                     "text":  "Go to Mission Control and launch"
                                                 },
                                      "dads_office":  {
                                                          "text":  "Something feels different in Dad\u0027s office…"
                                                      },
                                      "listen_tapes":  {
                                                           "text":  "Listen to Dad\u0027s tapes"
                                                       }
                                  },
