; Engine configuration file.
config_version=5

[application]

config/name="The Inheritance"
config/description="Single-player space mission design game for NASA Space Apps 2026."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

GameState="*res://scripts/systems/game_state.gd"
SceneManager="*res://scripts/systems/scene_manager.gd"
DataLoader="*res://scripts/systems/data_loader.gd"
StoryTriggers="*res://scripts/systems/story_triggers.gd"
Story="*res://scripts/systems/story.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
